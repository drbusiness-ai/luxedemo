{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noai, noimageai"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Copyright",
          "value": "AS BUILT template (c) 2026 MAFSAN. Proprietary. Presentation only. Not licensed for copying or AI training. See /LICENSE.txt"
        }
      ]
    }
  ]
}
